final code
#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* left;
    Node* right;

    Node(int value) {
        data = value;
        left = NULL;
        right = NULL;
    }
};

// Insert a node into BST
Node* insert(Node* root, int value) {
    if (root == NULL) {
        return new Node(value);
    }

    if (value < root->data) {
        root->left = insert(root->left, value);
    } else if (value > root->data) {
        root->right = insert(root->right, value);
    }

    return root;
}

// Inorder traversal
void inorder(Node* root) {
    if (root != NULL) {
        inorder(root->left);
        cout << root->data << " ";
        inorder(root->right);
    }
}

// Display leaf nodes
void displayLeafNodes(Node* root) {
    if (root == NULL) {
        return;
    }

    if (root->left == NULL && root->right == NULL) {
        cout << root->data << " ";
        return;
    }

    displayLeafNodes(root->left);
    displayLeafNodes(root->right);
}

// Count total nodes
int countNodes(Node* root) {
    if (root == NULL) {
        return 0;
    }

    return 1 + countNodes(root->left)
             + countNodes(root->right);
}

// Calculate height of each node
// Height is measured in edges.
// A leaf node has height 0.
int height(Node* root) {
    if (root == NULL) {
        return -1;
    }

    int leftHeight = height(root->left);
    int rightHeight = height(root->right);

    return 1 + (leftHeight > rightHeight
                ? leftHeight : rightHeight);
}

// Print height of every node
void printNodeHeights(Node* root) {
    if (root == NULL) {
        return;
    }

    cout << "Node " << root->data
         << ": Height = " << height(root) << endl;

    printNodeHeights(root->left);
    printNodeHeights(root->right);
}

// Free allocated memory
void deleteTree(Node* root) {
    if (root == NULL) {
        return;
    }

    deleteTree(root->left);
    deleteTree(root->right);
    delete root;
}

int main() {
    Node* root = NULL;
    int n, value;

    cout << "Enter number of nodes: ";
    cin >> n;

    if (n <= 0) {
        cout << "Please enter a positive number of nodes."
             << endl;
        return 0;
    }

    cout << "Enter node values:" << endl;

    for (int i = 0; i < n; i++) {
        cin >> value;
        root = insert(root, value);
    }

    cout << "\nInorder Traversal: ";
    inorder(root);

    cout << "\n\nLeaf Nodes: ";
    displayLeafNodes(root);

    cout << "\nTotal Number of Nodes: "
         << countNodes(root);

    cout << "\n\nHeight of Each Node:" << endl;
    printNodeHeights(root);

    cout << "\nHeight of BST: "
         << height(root) << endl;

    deleteTree(root);

    return 0;
}



